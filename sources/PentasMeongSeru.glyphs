@calt_CLOSE = [parenright bracketright braceright guillemetright guilsinglright];
@calt_CLOSE_case = [parenright.case bracketright.case braceright.case guillemetright.case guilsinglright.case];
@calt_BOTH = [hyphen endash emdash at slash backslash periodcentered periodcentered.loclCAT rightArrow leftArrow leftRightArrow upArrow downArrow northEastArrow southEastArrow southWestArrow northWestArrow upDownArrow];
@calt_BOTH_case = [hyphen.case endash.case emdash.case at.case slash.case backslash.case periodcentered.case periodcentered.loclCAT.case rightArrow.case leftArrow.case leftRightArrow.case upArrow.case downArrow.case northEastArrow.case southEastArrow.case southWestArrow.case northWestArrow.case upDownArrow.case];
@calt_CASED = [@calt_OPEN_case @calt_CLOSE_case @calt_BOTH_case bullet.case];

lookup calt_to_case {
    sub parenleft by parenleft.case;
    sub bracketleft by bracketleft.case;
    sub braceleft by braceleft.case;
    sub guillemetleft by guillemetleft.case;
    sub guilsinglleft by guilsinglleft.case;
    sub parenright by parenright.case;
    sub bracketright by bracketright.case;
    sub braceright by braceright.case;
    sub guillemetright by guillemetright.case;
    sub guilsinglright by guilsinglright.case;
    sub hyphen by hyphen.case;
    sub endash by endash.case;
    sub emdash by emdash.case;
    sub at by at.case;
    sub slash by slash.case;
    sub backslash by backslash.case;
    sub periodcentered by periodcentered.case;
    sub periodcentered.loclCAT by periodcentered.loclCAT.case;
    sub rightArrow by rightArrow.case;
    sub leftArrow by leftArrow.case;
    sub leftRightArrow by leftRightArrow.case;
    sub upArrow by upArrow.case;
    sub downArrow by downArrow.case;
    sub northEastArrow by northEastArrow.case;
    sub southEastArrow by southEastArrow.case;
    sub southWestArrow by southWestArrow.case;
    sub northWestArrow by northWestArrow.case;
    sub upDownArrow by upDownArrow.case;
    sub bullet by bullet.case;
} calt_to_case;
";
name = "calt classes";
