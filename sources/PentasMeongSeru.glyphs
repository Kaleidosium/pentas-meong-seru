{
automatic = 1;
code = "lookupflag IgnoreMarks;
sub f f i by f_f_i;
sub f f l by f_f_l;
sub f f by f_f;
sub r slash by r_slash.liga;
sub f i by fi;
sub f l by fl;
";
tag = liga;
},
{
code = "# Arrows from ASCII sequences. \"<-\" right before a number is \"less than
# minus\" (x<-1), not an arrow, so it stays as typed.
lookup calt_arrows {
    ignore sub less' hyphen' @calt_FIG;
    ignore sub less' hyphen' period @calt_FIG;
    sub less' hyphen' hyphen' greater' by leftRightArrow;
    sub less' hyphen' greater' by leftRightArrow;
    sub less' hyphen' hyphen' by leftArrow;
    sub less' hyphen' by leftArrow;
    sub hyphen' hyphen' greater' by rightArrow;
    sub hyphen' greater' by rightArrow;
} calt_arrows;

# Figures: 3x9 -> 3 multiply 9, 12:34 -> raised colon. A 0 that starts a
# number before x is a hex prefix (0x1F, 0xFF), so that x stays; 10x10 and
# 1920x1080 still get the multiplication sign. x.sc too: with smcp, and in the
# SC family (where the lowercase is already small caps), x is x.sc by now.
lookup calt_figures {
    sub @calt_FIG @calt_ZERO [x x.sc]' @calt_FIG by multiply;
    ignore sub @calt_ZERO [x x.sc]';
    sub @calt_FIG [x x.sc]' @calt_FIG by multiply;
    sub @calt_FIG colon' @calt_FIG by colon.case;
} calt_figures;

# Opening brackets before capitals/figures (right to left, so ((A also works)
lookup calt_open {
    rsub @calt_OPEN' [@calt_UCF @calt_OPEN_case] by @calt_OPEN_case;
} calt_open;

# Closing brackets after capitals/figures
lookup calt_close {
    sub [@calt_UCF @calt_CLOSE_case] @calt_CLOSE' lookup calt_to_case;
} calt_close;

# Dashes, @, slashes, middle dot, arrows: capitals/figures on both sides
lookup calt_both {
    sub [@calt_UCF @calt_CASED] @calt_BOTH' lookup calt_to_case [@calt_UCF @calt_OPEN_case];
} calt_both;

# Bullet before a capital or figure
lookup calt_bullet {
    sub bullet' lookup calt_to_case @calt_UCF;
    sub bullet' lookup calt_to_case space @calt_UCF;
} calt_bullet;
";
tag = calt;
},
