{
code = "# pi and the Ohm sign (and their small caps) are Greek-script characters.
# Without a grek language system, ufo2ft registers grek in GPOS for kern only,
# so shapers find no cpsp (or other positioning features) for them.
languagesystem grek dflt;
";
name = Greek;
},
{
code = "# Contextual alternates (calt) support: classes and the single substitution lookup it calls.
